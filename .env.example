# Скопировать в .env: cp .env.example .env
# Порт, на котором приложение доступно с хоста.
HTTP_PORT=8082

# UID/GID хоста — чтобы файлы, созданные контейнером, не принадлежали root.
UID=1000
GID=1000

# off | coverage | debug
XDEBUG_MODE=off

DB_NAME=book_catalogue
DB_USER=catalogue
DB_PASSWORD=catalogue
DB_ROOT_PASSWORD=root
# Порт MySQL на хосте (для подключения из IDE).
DB_PORT=33061

# Пароль единственной учётной записи admin; применяется сидером при миграции.
ADMIN_PASSWORD=admin
