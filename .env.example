# Скопировать в .env: cp .env.example .env
# Порт, на котором приложение доступно с хоста.
HTTP_PORT=8082

# UID/GID хоста — чтобы файлы, созданные контейнером, не принадлежали root.
UID=1000
GID=1000

# off | coverage | debug
XDEBUG_MODE=off

DB_NAME=book_catalogue
DB_USER=catalogue
DB_PASSWORD=catalogue
DB_ROOT_PASSWORD=root
# Порт MySQL на хосте (для подключения из IDE).
DB_PORT=33061

# Пароль единственной учётной записи admin; применяется сидером при миграции.
ADMIN_PASSWORD=admin

# Ключ API smspilot.ru. По умолчанию — ключ-эмулятор: запросы принимаются,
# но реальные SMS не отправляются.
SMSPILOT_API_KEY=XXXXXXXXXXXXYYYYYYYYYYYYZZZZZZZZZZZZ

# Ключ подписи cookie (в том числе `_identity` автологина). Сгенерировать:
#   docker compose exec -T php php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
COOKIE_VALIDATION_KEY=

# Режим приложения. dev — открыты Gii, Debug и трассировки исключений;
# для любого не-локального запуска: YII_ENV=prod, YII_DEBUG=0.
YII_ENV=dev
YII_DEBUG=1
