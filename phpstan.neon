parameters:
    level: 5

    paths:
        - assets
        - commands
        - components
        - controllers
        - mail
        - migrations
        - models
        - widgets
        - tests/Functional
        - tests/Unit

    scanDirectories:
        - tests/Support

    bootstrapFiles:
        - tests/_bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    ignoreErrors:
        - '#Unsafe usage of new static\(\).#'
        # Атрибуты DynamicModel объявляются в рантайме — статически их не видно.
        -
            message: '#Access to an undefined property yii\\base\\DynamicModel::#'
            path: tests/*

    tmpDir: %currentWorkingDirectory%/runtime
