<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Yii2">
    <rule ref="vendor/yiisoft/yii2-coding-standards/Yii2"></rule>

    <!-- Имена классов миграций задаёт сам Yii (m<дата>_<время>_<описание>),
         переименовать их нельзя — иначе migrate их не найдёт. -->
    <rule ref="Squiz.Classes.ValidClassName.NotPascalCase">
        <exclude-pattern>migrations/*</exclude-pattern>
    </rule>

    <!-- generate relative paths -->
    <arg name="basepath" value="."/>

    <!-- directories to check -->
    <file>assets</file>
    <file>commands</file>
    <file>components</file>
    <file>controllers</file>
    <file>mail</file>
    <file>migrations</file>
    <file>models</file>
    <file>tests</file>
    <file>widgets</file>
</ruleset>
